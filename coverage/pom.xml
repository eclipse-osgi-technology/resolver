<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.osgi-technology.resolver</groupId>
    <artifactId>resolver</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>coverage</artifactId>
  <packaging>pom</packaging>

  <name>OSGi Resolver Coverage</name>
  <description>Aggregates the code coverage of all modules, including the scenarios that run in the resolver harnesses</description>

  <properties>
    <!-- the module only creates a report and has no artifact to install or deploy -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- report-aggregate takes the coverage of the compile and runtime dependencies in the reactor -->
  <dependencies>
    <dependency>
      <groupId>org.eclipse.osgi-technology.resolver</groupId>
      <artifactId>index</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.osgi-technology.resolver</groupId>
      <artifactId>verifier</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.osgi-technology.resolver</groupId>
      <artifactId>test-suite</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.osgi-technology.resolver</groupId>
      <artifactId>felix-resolver</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <!-- this module has no tests and no classes of its own -->
          <execution>
            <id>prepare-agent</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>report</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>report-aggregate</id>
            <phase>verify</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
