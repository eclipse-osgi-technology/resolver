  <modules>
  </modules>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/eclipse-osgi-technology/resolver/issues</url>
  </issueManagement>

  <properties>
    <java.version>25</java.version>
    <java.release>25</java.release>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>
</project>
